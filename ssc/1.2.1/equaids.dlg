INCLUDE ifin
INCLUDE weights_fpai

DIALOG se, tabtitle("SE/Robust")
BEGIN
  GROUPBOX gb_v        10   10  640 240, label("Variance estimator (coefficients and elasticities)")
  RADIO    rb_robust   20   30  600   ., first label("Robust (default)") onclickon(program vce_state)
  RADIO    rb_cluster  20   55  250   ., label("Clustered by:") onclickon(program vce_state)
  VARNAME  vn_clust   270   55  200   ., label("Cluster variable")
  RADIO    rb_svy      20   80  600   ., label("Survey design declared by svyset (strata, PSUs, fpc, pweight)") ///
           onclickon(program vce_state)
  RADIO    rb_conv     20  105  600   ., label("Conventional (coefficients; homoskedastic errors, no weights)") ///
           onclickon(program vce_state)
  RADIO    rb_boot     20  130  600   ., last label("Bootstrap of the whole procedure (prices filled, probits and system estimated again)") ///
           onclickon(program vce_state)
  TEXT     tx_reps     40  155  100   ., label("Replications:")
  SPINNER  sp_reps    145  155   70   ., label("Replications") min(2) max(100000) default(200)
  TEXT     tx_seed    235  155   40   ., label("Seed:")
  EDIT     ed_seed    280  155   90   ., label("Seed") numonly
  CHECKBOX ck_bsvy    390  155  250   ., label("Resample the PSUs of svyset")
  TEXT     tx_svy      40  185  600   ., label("With the survey design, leave the Weights tab empty: the weight comes from svyset.")
  TEXT     tx_svy2     40  205  600   ., label("Strata with a single PSU follow svyset's singleunit() option.")
  TEXT     tx_bnote    40  225  600   ., label("Use the bootstrap when equaids warns that the linearized standard errors are unreliable.")
END

PROGRAM vce_state
BEGIN
  if se.rb_cluster & !has_diag {
    call se.vn_clust.enable
  }
  if !se.rb_cluster | has_diag {
    call se.vn_clust.disable
  }
  if se.rb_boot & !has_diag {
    call se.sp_reps.enable
    call se.ed_seed.enable
    call se.ck_bsvy.enable
  }
  if !se.rb_boot | has_diag {
    call se.sp_reps.disable
    call se.ed_seed.disable
    call se.ck_bsvy.disable
  }
END

DIALOG rpt, tabtitle("Reporting")
BEGIN
  GROUPBOX gb_el       10   10  640  75, label("Elasticities")
  COMBOBOX cb_el       20   28  620   ., dropdownlist contents(ellist) values(elvals) ///
           default(households) option(elasticities) onselchange(program el_state) label("Elasticities")
  TEXT     tx_hhs      20   53  300   ., label("Size of the household (individuals only):")
  VARNAME  vn_hhs     330   53  310   ., label("Household size") numeric

  GROUPBOX gb_disp     10   93  640 185, label("Display")
  DEFINE _x 20
  DEFINE _cx 150
  DEFINE _y 113
  INCLUDE _sp_level
  TEXT     tx_dec     280  113  120   ., label("Decimals:")
  SPINNER  sp_dec     405  113   60   ., label("Decimals") min(0) max(8) default(4) option(dec)
  CHECKBOX ck_comp     20  140  610   ., label("Add the compensated (Hicksian) price elasticities") option(compensated)
  CHECKBOX ck_checks   20  162  610   ., label("Show the aggregation identities (Engel, Cournot, homogeneity, symmetry)") option(checks)
  CHECKBOX ck_stars    20  184  610   ., label("Significance stars on the estimates") option(stars)
  CHECKBOX ck_dislas   20  206  300   ., label("Show the last good") default(1)
  CHECKBOX ck_dreg    330  206  300   ., label("Display the coefficients")
  CHECKBOX ck_noese    20  228  300   ., label("Skip the standard errors of the elasticities") option(noelastse)
  CHECKBOX ck_notab   330  228  300   ., label("Do not display the tables") option(notable)

  GROUPBOX gb_save     10  285  640  70, label("Save the tables")
  TEXT     tx_save     20  305  620   ., label("File (the extension gives the format: .docx .tex .xlsx .csv .md):")
  FILE     fi_save     20  325  620   ., label("Browse...") save option(saveres) ///
           filter("Word (*.docx)|*.docx|LaTeX (*.tex)|*.tex|Excel (*.xlsx)|*.xlsx|CSV (*.csv)|*.csv|Markdown (*.md)|*.md")
END

LIST ellist
BEGIN
  Households: mean over the households, each by its weight (default)
  Individuals: each household counts for its weight times its size
  Market: elasticities of total demand, each household by its expenditure
  Reference household, at the means of ln p, ln x and z
  Mean of the household elasticities, not weighted by the shares (hhmean)
END
LIST elvals
BEGIN
  households
  individuals
  market
  reference
  hhmean
END

// the household size, for the elasticities of the individual only
PROGRAM el_state
BEGIN
  if rpt.cb_el.iseq("individuals") & !has_diag {
    call rpt.tx_hhs.enable
    call rpt.vn_hhs.enable
  }
  if !rpt.cb_el.iseq("individuals") | has_diag {
    call rpt.tx_hhs.disable
    call rpt.vn_hhs.disable
  }
END

DIALOG conv, tabtitle("Estimation")
BEGIN
  GROUPBOX gb_c        10   10  640 110, label("Iterated FGNLS (Gauss-Newton, analytic Jacobian)")
  TEXT     tx_tol      20   30  450   ., label("Tolerance on the Newton decrement g'A^-1 g (default 1e-6):")
  EDIT     ed_tol     480   30  100   ., label("Tolerance") numonly default(1e-6) option(tolerance)
  TEXT     tx_it       20   58  450   ., label("Maximum number of iterations:")
  SPINNER  sp_it      480   58  100   ., label("Iterations") min(1) max(10000) default(300) option(iterate)
  CHECKBOX ck_nolog    20   86  600   ., label("Suppress the iteration log") option(nolog) default(1)
END

DIALOG dg, tabtitle("Diagnostic")
BEGIN
  GROUPBOX gb_d        10   10  640 120, label("equaidsdiag: sensitivity to alpha_0 (the only part that estimates)")
  CHECKBOX ck_sens     20   30  600   ., label("Estimate the model at several values of alpha_0 (sensitivity)") option(sensitivity)
  TEXT     tx_a0l      20   58  600   ., label("Values of alpha_0 (default: min ln x - 0.1, and 1, 2 and 4 below):")
  EDIT     ed_a0l      20   78  620   ., label("alpha_0 values") option(a0list)
  TEXT     tx_dnote    20  104  620   ., label("Sections D0-D5 (data, prices, alpha_0, demographics, conditioning, small goods) always run.")
END

// controls of the estimator alone are greyed out under the diagnostic, and
// the Diagnostic tab under the estimation
PROGRAM set_mode
BEGIN
  if has_diag {
    call se.rb_robust.disable
    call se.rb_cluster.disable
    call se.rb_svy.disable
    call se.rb_conv.disable
    call se.rb_boot.disable
    call rpt.cb_el.disable
    call rpt.sp_level.disable
    call rpt.sp_dec.disable
    call rpt.ck_comp.disable
    call rpt.ck_checks.disable
    call rpt.ck_stars.disable
    call rpt.ck_dislas.disable
    call rpt.ck_dreg.disable
    call rpt.ck_noese.disable
    call rpt.ck_notab.disable
    call rpt.fi_save.disable
    call main.ed_snames.disable
    call conv.ed_tol.disable
    call conv.sp_it.disable
    call conv.ck_nolog.disable
    call dg.ck_sens.enable
    call dg.ed_a0l.enable
  }
  if !has_diag {
    call se.rb_robust.enable
    call se.rb_cluster.enable
    call se.rb_svy.enable
    call se.rb_conv.enable
    call se.rb_boot.enable
    call rpt.cb_el.enable
    call rpt.sp_level.enable
    call rpt.sp_dec.enable
    call rpt.ck_comp.enable
    call rpt.ck_checks.enable
    call rpt.ck_stars.enable
    call rpt.ck_dislas.enable
    call rpt.ck_dreg.enable
    call rpt.ck_noese.enable
    call rpt.ck_notab.enable
    call rpt.fi_save.enable
    call main.ed_snames.enable
    call conv.ed_tol.enable
    call conv.sp_it.enable
    call conv.ck_nolog.enable
    call dg.ck_sens.disable
    call dg.ed_a0l.disable
  }
  call program vce_state
  call program el_state
END

PROGRAM command
BEGIN
  if has_diag {
    put "equaidsdiag "
  }
  if !has_diag {
    put "equaids "
  }
  require main.vl_shares
  varlist main.vl_shares
  put " " /program ifin_output
  put " " /program weights_output
  beginoptions
    require main.vl_prices
    if main.rb_plev {
      put " prices(" main.vl_prices ")"
    }
    if main.rb_plog {
      put " lnprices(" main.vl_prices ")"
    }
    require main.vn_exp
    if main.rb_xlev {
      put " expenditure(" main.vn_exp ")"
    }
    if main.rb_xlog {
      put " lnexpenditure(" main.vn_exp ")"
    }
    option main.rb_aids
    optionarg main.vl_demo
    optionarg main.vl_pimp
    if sel.ck_sel {
      put " selection"
      if sel.ed_selg {
        put " selgoods(" sel.ed_selg ")"
      }
      if sel.vl_v1 {
        require sel.ed_g1
      }
      if sel.ed_g1 {
        require sel.vl_v1
      }
      if sel.vl_v2 {
        require sel.ed_g2
      }
      if sel.ed_g2 {
        require sel.vl_v2
      }
      if sel.vl_v3 {
        require sel.ed_g3
      }
      if sel.ed_g3 {
        require sel.vl_v3
      }
      if sel.vl_v4 {
        require sel.ed_g4
      }
      if sel.ed_g4 {
        require sel.vl_v4
      }
      if sel.vl_v5 {
        require sel.ed_g5
      }
      if sel.ed_g5 {
        require sel.vl_v5
      }
      if sel.vl_v6 {
        require sel.ed_g6
      }
      if sel.ed_g6 {
        require sel.vl_v6
      }
      if sel.vl_v7 {
        require sel.ed_g7
      }
      if sel.ed_g7 {
        require sel.vl_v7
      }
      if sel.vl_v8 {
        require sel.ed_g8
      }
      if sel.ed_g8 {
        require sel.vl_v8
      }
      if sel.vl_v9 {
        require sel.ed_g9
      }
      if sel.ed_g9 {
        require sel.vl_v9
      }
      if sel.vl_v10 {
        require sel.ed_g10
      }
      if sel.ed_g10 {
        require sel.vl_v10
      }
      if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 | sel.ed_g7 | sel.ed_g8 | sel.ed_g9 | sel.ed_g10 {
        put " selvars("
        put sel.vl_all
        if sel.ed_g1 {
          if sel.vl_all {
            put "; "
          }
          put sel.ed_g1 ": " sel.vl_v1
        }
        if sel.ed_g2 {
          if sel.vl_all | sel.ed_g1 {
            put "; "
          }
          put sel.ed_g2 ": " sel.vl_v2
        }
        if sel.ed_g3 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 {
            put "; "
          }
          put sel.ed_g3 ": " sel.vl_v3
        }
        if sel.ed_g4 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 {
            put "; "
          }
          put sel.ed_g4 ": " sel.vl_v4
        }
        if sel.ed_g5 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 {
            put "; "
          }
          put sel.ed_g5 ": " sel.vl_v5
        }
        if sel.ed_g6 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 {
            put "; "
          }
          put sel.ed_g6 ": " sel.vl_v6
        }
        if sel.ed_g7 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 {
            put "; "
          }
          put sel.ed_g7 ": " sel.vl_v7
        }
        if sel.ed_g8 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 | sel.ed_g7 {
            put "; "
          }
          put sel.ed_g8 ": " sel.vl_v8
        }
        if sel.ed_g9 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 | sel.ed_g7 | sel.ed_g8 {
            put "; "
          }
          put sel.ed_g9 ": " sel.vl_v9
        }
        if sel.ed_g10 {
          if sel.vl_all | sel.ed_g1 | sel.ed_g2 | sel.ed_g3 | sel.ed_g4 | sel.ed_g5 | sel.ed_g6 | sel.ed_g7 | sel.ed_g8 | sel.ed_g9 {
            put "; "
          }
          put sel.ed_g10 ": " sel.vl_v10
        }
        put ")"
      }
    }
    if main.ck_anot {
      require main.ed_anot
      optionarg main.ed_anot
    }
    if has_diag {
      option dg.ck_sens
      optionarg dg.ed_a0l
    }
    if !has_diag {
      optionarg main.ed_snames
      if se.rb_cluster {
        require se.vn_clust
        put " vce(cluster " se.vn_clust ")"
      }
      if se.rb_svy {
        put " vce(svy)"
      }
      if se.rb_conv {
        put " vce(conventional)"
      }
      if se.rb_boot {
        put " vce(bootstrap, reps(" se.sp_reps ")"
        if se.ed_seed {
          put " seed(" se.ed_seed ")"
        }
        if se.ck_bsvy {
          put " svy"
        }
        put ")"
      }
      optionarg /hidedefault rpt.cb_el
      if rpt.cb_el.iseq("individuals") {
        require rpt.vn_hhs
        put " hhsize(" rpt.vn_hhs ")"
      }
      optionarg /hidedefault rpt.sp_level
      optionarg /hidedefault rpt.sp_dec
      option rpt.ck_comp
      option rpt.ck_checks
      option rpt.ck_stars
      if !rpt.ck_dislas {
        put " dislas(0)"
      }
      if rpt.ck_dreg {
        put " dregres(1)"
      }
      option rpt.ck_noese
      option rpt.ck_notab
      if rpt.fi_save {
        optionarg /quoted rpt.fi_save
      }
      optionarg /hidedefault conv.ed_tol
      optionarg /hidedefault conv.sp_it
      option conv.ck_nolog
    }
  endoptions
END
